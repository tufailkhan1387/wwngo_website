# Copy to `.env` and set your real credentials.
# This backend must use the marketing website DB only (wwngo_website).
# Do not connect to the mobile app database.

PORT=5000
CORS_ORIGIN=http://localhost:5173

# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Password must be a non-empty string.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/wwngo_website

# Optional: WhatsApp alert (via Wati) for each contact form submission.
# WATI_NOTIFY_TO = number to alert, country code without + (e.g. 923001234567).
WATI_API_KEY=
WATI_NOTIFY_TO=
